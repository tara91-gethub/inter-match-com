---
import RegionPage from '~/components/RegionPage.astro';
import penangImg from '~/assets/images/cities/penang.jpg';
const metadata = {
  title: 'Private Matchmaking in Penang | The Matchmaking Bureau',
  description:
    'Private matchmaking in Penang for discerning Malaysian professionals seeking serious introductions with privacy and personal judgment.',
};
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://www.matchmakingbureau.com',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Malaysia',
      item: 'https://www.matchmakingbureau.com/malaysia',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Penang',
      item: 'https://www.matchmakingbureau.com/malaysia/penang',
    },
  ],
};
const links = [{ text: 'Malaysia', href: '/malaysia' }];
---

<RegionPage
  metadata={metadata}
  eyebrow="Private Matchmaking"
  hero="Penang Bureau"
  body="Penang combines heritage, professional ambition and a close social environment where privacy matters. The Matchmaking Bureau serves Penang with thoughtful, hand-selected introductions for people who want a serious search guided by discretion and personal understanding."
  image={penangImg}
  links={links}
  schema={schema}
/>
