---
import RegionPage from '~/components/RegionPage.astro';
import baliImg from '~/assets/images/cities/bali.jpg';
const metadata = {
  title: 'Private Matchmaking in Bali | The Matchmaking Bureau',
  description:
    'Private matchmaking in Bali for discerning professionals and international singles seeking serious introductions with complete discretion.',
};
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://www.matchmakingbureau.com',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Indonesia',
      item: 'https://www.matchmakingbureau.com/indonesia',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Bali',
      item: 'https://www.matchmakingbureau.com/indonesia/bali',
    },
  ],
};
const links = [{ text: 'Indonesia', href: '/indonesia' }];
---

<RegionPage
  metadata={metadata}
  eyebrow="Private Matchmaking"
  hero="Bali Bureau"
  body="Bali attracts internationally minded professionals, entrepreneurs and established individuals who value privacy, lifestyle and meaningful connection. The Matchmaking Bureau serves Bali with personal, carefully considered introductions for people seeking a serious relationship without unnecessary visibility."
  image={baliImg}
  imageAlt="Luxury coastal resort setting in Bali at sunset"
  links={links}
  schema={schema}
/>
