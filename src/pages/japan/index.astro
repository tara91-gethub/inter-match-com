---
import RegionPage from '~/components/RegionPage.astro';
import japanImg from '~/assets/images/countries/japan.jpg';
import tokyoImg from '~/assets/images/cities/tokyo.jpg';
import osakaImg from '~/assets/images/cities/osaka.jpg';

const metadata = {
  title: 'Private Matchmaking in Japan',
  description:
    'Private matchmaking in Japan for discerning professionals. Serving Tokyo and Osaka with confidential, carefully considered introductions.',
};
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://www.matchmakingbureau.com',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Japan',
      item: 'https://www.matchmakingbureau.com/japan',
    },
  ],
};
const cards = [
  { title: 'Tokyo', href: '/japan/tokyo', image: tokyoImg, imageAlt: 'Tokyo skyline with Tokyo Tower' },
  { title: 'Osaka', href: '/japan/osaka', image: osakaImg, imageAlt: 'Osaka skyline and Umeda district' },
];
---

<RegionPage
  metadata={metadata}
  eyebrow="Private Matchmaking"
  hero="Japan Bureau"
  body="Japan brings together professional accomplishment, privacy and a considered approach to personal relationships. The Matchmaking Bureau serves discerning people across Japan with confidential introductions shaped by serious intentions, shared values and long-term compatibility."
  image={japanImg}
  imageAlt="Mount Fuji above Japanese city lights beneath a star-filled sky"
  cards={cards}
  links={[]}
  schema={schema}
/>
