---
import RegionPage from '~/components/RegionPage.astro';
import chiangMaiImg from '~/assets/images/cities/chiang-mai.jpg';
const metadata = {
  title: 'Private Matchmaking in Chiang Mai | The Matchmaking Bureau',
  description:
    'Private matchmaking in Chiang Mai for discerning professionals and serious singles seeking a discreet, personal introduction service.',
};
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://www.matchmakingbureau.com',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Thailand',
      item: 'https://www.matchmakingbureau.com/thailand',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Chiang Mai',
      item: 'https://www.matchmakingbureau.com/thailand/chiang-mai',
    },
  ],
};
const links = [{ text: 'Thailand', href: '/thailand' }];
---

<RegionPage
  metadata={metadata}
  eyebrow="Private Matchmaking"
  hero="Chiang Mai Bureau"
  body="Chiang Mai appeals to thoughtful, internationally aware individuals who value a calmer pace, culture and substance. The Matchmaking Bureau serves Chiang Mai with discreet introductions for people seeking a serious relationship through a more personal and selective approach."
  image={chiangMaiImg}
  imageAlt="Chiang Mai mountain and city view from a private villa at sunset"
  links={links}
  schema={schema}
/>
