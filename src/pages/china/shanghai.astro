---
import RegionPage from '~/components/RegionPage.astro';
import shanghaiImg from '~/assets/images/cities/shanghai.jpg';
const metadata = {
  title: 'Private Matchmaking in Shanghai | The Matchmaking Bureau',
  description:
    'Private matchmaking in Shanghai for discerning Chinese and international professionals seeking serious introductions.',
};
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.matchmakingbureau.com' },
    { '@type': 'ListItem', position: 2, name: 'China', item: 'https://www.matchmakingbureau.com/china' },
    { '@type': 'ListItem', position: 3, name: 'Shanghai', item: 'https://www.matchmakingbureau.com/china/shanghai' },
  ],
};
const links = [{ text: 'China', href: '/china' }];
---

<RegionPage
  metadata={metadata}
  eyebrow="Private Matchmaking"
  hero="Shanghai Bureau"
  body="Shanghai is one of Asia's most international business cities, where ambition, privacy and social reputation often sit close together. The Matchmaking Bureau serves Shanghai with discreet introductions for accomplished people who want a serious relationship search handled with care."
  image={shanghaiImg}
  imageAlt="Shanghai skyline and river at sunset"
  links={links}
  schema={schema}
/>
