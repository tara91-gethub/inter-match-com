---
import RegionPage from '~/components/RegionPage.astro';
import hongKongImg from '~/assets/images/cities/hong-kong.jpg';
const metadata = {
  title: 'Private Matchmaking in Hong Kong | The Matchmaking Bureau',
  description:
    'Private matchmaking in Hong Kong for discerning professionals seeking discreet, serious and carefully considered introductions.',
};
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.matchmakingbureau.com' },
    { '@type': 'ListItem', position: 2, name: 'China', item: 'https://www.matchmakingbureau.com/china' },
    { '@type': 'ListItem', position: 3, name: 'Hong Kong', item: 'https://www.matchmakingbureau.com/china/hong-kong' },
  ],
};
const links = [{ text: 'China', href: '/china' }];
---

<RegionPage
  metadata={metadata}
  eyebrow="Private Matchmaking"
  hero="Hong Kong Bureau"
  body="Hong Kong is one of the world's most private and reputation-conscious professional cities. The Matchmaking Bureau serves Hong Kong with selective introductions for accomplished individuals who want discretion, seriousness and a more human approach to connection."
  image={hongKongImg}
  imageAlt="Hong Kong harbour skyline at blue hour"
  links={links}
  schema={schema}
/>
