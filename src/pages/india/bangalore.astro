---
import RegionPage from '~/components/RegionPage.astro';
import bangaloreImg from '~/assets/images/cities/bangalore.jpg';
const metadata = {
  title: 'Private Matchmaking in Bangalore | The Matchmaking Bureau',
  description:
    'Private matchmaking in Bangalore for discerning technology and business professionals seeking serious introductions.',
};
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.matchmakingbureau.com' },
    { '@type': 'ListItem', position: 2, name: 'India', item: 'https://www.matchmakingbureau.com/india' },
    { '@type': 'ListItem', position: 3, name: 'Bangalore', item: 'https://www.matchmakingbureau.com/india/bangalore' },
  ],
};
const links = [{ text: 'India', href: '/india' }];
---

<RegionPage
  metadata={metadata}
  eyebrow="Private Matchmaking"
  hero="Bangalore Bureau"
  body="Bangalore is India's technology and innovation capital, home to founders, executives and globally minded professionals. The Matchmaking Bureau serves Bangalore with discreet, selective introductions for people seeking a serious relationship beyond public dating."
  image={bangaloreImg}
  imageAlt="Bangalore skyline at blue hour"
  links={links}
  schema={schema}
/>
